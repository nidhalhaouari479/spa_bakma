# ------------------------------------------------------------------
# Bakma Store — variables d'environnement
# Copier ce fichier en .env.local puis renseigner les valeurs.
# Supabase > Project Settings > API
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# URLs des 3 applications (liens croisés, redirections après inscription)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_VET_URL=http://localhost:3002

# Serveur uniquement : création des comptes après vérification du code (inscription)
SUPABASE_SERVICE_ROLE_KEY=

# Envoi des codes de vérification par e-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true pour le port 465 (SSL), false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Bakma Store
